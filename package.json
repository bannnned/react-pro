		"build:esbuild": "node scripts/esbuild.mjs",
		"serve:webpack": "node scripts/serve.mjs dist",
		"serve:esbuild": "node scripts/serve.mjs dist-esbuild",
		"typecheck": "tsc --noEmit",
		"benchmark": "npm run typecheck && node scripts/benchmark.mjs",
		"lint": "eslint src --ext .ts,.tsx",
		"format": "prettier --write src scripts webpack package.json tsconfig.json"
	},
